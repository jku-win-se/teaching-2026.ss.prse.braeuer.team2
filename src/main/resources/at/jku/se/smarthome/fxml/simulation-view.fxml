<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="at.jku.se.smarthome.controller.SimulationController"
            prefWidth="1100"
            prefHeight="700"
            style="-fx-background-color: #f7f5f2;">

    <left>
        <VBox spacing="18"
              prefWidth="200"
              style="-fx-background-color: #f0ede8; -fx-padding: 24;">
            <children>
                <Label text="homeE"
                       style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #2b2b2b;" />
                <VBox spacing="10">
                    <children>
                        <Button text="Dashboard"
                                onAction="#openDashboard"
                                prefWidth="150"
                                style="-fx-background-color: transparent; -fx-text-fill: #6e6257;" />
                        <Button text="Rules"
                                onAction="#openRules"
                                prefWidth="150"
                                style="-fx-background-color: transparent; -fx-text-fill: #6e6257;" />
                        <Button text="Schedules"
                                onAction="#openSchedules"
                                prefWidth="150"
                                style="-fx-background-color: transparent; -fx-text-fill: #6e6257;" />
                        <Button text="Vacation Mode"
                                onAction="#openVacationMode"
                                prefWidth="150"
                                style="-fx-background-color: transparent; -fx-text-fill: #6e6257;" />
                        <Button text="Scenes"
                                onAction="#openScenes"
                                prefWidth="150"
                                style="-fx-background-color: transparent; -fx-text-fill: #6e6257;" />
                        <Button text="Activity"
                                onAction="#openActivity"
                                prefWidth="150"
                                style="-fx-background-color: transparent; -fx-text-fill: #6e6257;" />
                        <Button text="Energy"
                                onAction="#openEnergy"
                                prefWidth="150"
                                style="-fx-background-color: transparent; -fx-text-fill: #6e6257;" />
                        <Button text="Simulation"
                                prefWidth="150"
                                style="-fx-background-color: #e3ded7; -fx-background-radius: 10; -fx-text-fill: #2b2b2b;" />
                    </children>
                </VBox>
            </children>
        </VBox>
    </left>

    <center>
        <VBox spacing="20" style="-fx-padding: 28;">
            <children>
                <HBox spacing="8">
                    <children>
                        <Label text="Day Simulation"
                               style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #2b2b2b;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button text="Logout"
                                onAction="#logout"
                                style="-fx-background-color: transparent; -fx-text-fill: #6e6257;" />
                    </children>
                </HBox>

                <HBox spacing="18">
                    <children>
                        <VBox spacing="14"
                              prefWidth="360"
                              style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 16;">
                            <children>
                                <Label text="Start"
                                       style="-fx-font-size: 16; -fx-text-fill: #6e6257;" />
                                <DatePicker fx:id="startDatePicker" />
                                <HBox spacing="8">
                                    <children>
                                        <Spinner fx:id="startHourSpinner" prefWidth="90" />
                                        <Label text=":" />
                                        <Spinner fx:id="startMinuteSpinner" prefWidth="90" />
                                    </children>
                                </HBox>

                                <Label text="Initial sensor values"
                                       style="-fx-font-size: 16; -fx-text-fill: #6e6257;" />
                                <VBox fx:id="sensorInputContainer" spacing="8" />

                                <Label text="Active rules"
                                       style="-fx-font-size: 16; -fx-text-fill: #6e6257;" />
                                <VBox fx:id="activeRuleContainer" spacing="8" />

                                <HBox spacing="8">
                                    <children>
                                        <Button text="Start Simulation"
                                                onAction="#startSimulation"
                                                style="-fx-background-color: #e8752e; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 16 10 16;" />
                                        <Button text="Stop"
                                                onAction="#stopSimulation"
                                                style="-fx-background-color: #e3ded7; -fx-text-fill: #2b2b2b; -fx-background-radius: 8; -fx-padding: 10 16 10 16;" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <VBox spacing="12" HBox.hgrow="ALWAYS">
                            <children>
                                <Label fx:id="summaryLabel"
                                       wrapText="true"
                                       style="-fx-text-fill: #6e6257;" />
                                <ScrollPane fitToWidth="true"
                                            style="-fx-background-color: transparent; -fx-background: transparent;">
                                    <content>
                                        <VBox fx:id="playbackContainer"
                                              spacing="8"
                                              style="-fx-padding: 2;" />
                                    </content>
                                </ScrollPane>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>
